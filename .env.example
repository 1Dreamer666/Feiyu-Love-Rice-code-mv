# ============================================================
# 《肥鱼爱大米》环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会入库。
#   cp .env.example .env
# ============================================================

# ---------- MiMo TTS（小米 MiMo）----------
# 用于生成「唱歌」音源（mimo-v2.5-tts 的 (唱歌) 模式）。
# 获取地址：https://mimo.mi.com/ 控制台
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---------- 其他可选 ----------
# 若使用需要鉴权的 GitHub 推送，建议改用 gh auth login 或 SSH，不要把 token 写在这里。
# GITHUB_TOKEN=
